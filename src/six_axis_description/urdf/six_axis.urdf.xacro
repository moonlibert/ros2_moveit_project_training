<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_axis">

  <!-- ========== 可调参数：改这里就能改机械臂尺寸 ========== -->
  <xacro:property name="base_radius"  value="0.08"/>
  <xacro:property name="base_height"  value="0.05"/>
  <xacro:property name="link1_height" value="0.15"/>  <!-- 立柱 -->
  <xacro:property name="link2_length" value="0.30"/>  <!-- 大臂 -->
  <xacro:property name="link3_length" value="0.25"/>  <!-- 小臂 -->
  <xacro:property name="link4_length" value="0.08"/>  <!-- 腕滚转段 -->
  <xacro:property name="link5_length" value="0.08"/>  <!-- 腕俯仰段 -->
  <xacro:property name="link6_length" value="0.05"/>  <!-- 法兰段 -->

  <!-- ========== 颜色 ========== -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.4 0.1 1.0"/>
  </material>

  <!-- ========== 连杆宏：link 原点 = 底端关节处，圆柱沿 +z 伸出 ========== -->
  <xacro:macro name="arm_link" params="name radius length mass color">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length/2}"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
      <!-- 实心圆柱惯量公式，MoveIt 动力学需要 -->
      <inertial>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (3*radius**2 + length**2) / 12}"
          ixy="0.0" ixz="0.0"
          iyy="${mass * (3*radius**2 + length**2) / 12}"
          iyz="0.0"
          izz="${mass * radius**2 / 2}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ========== 底座 ========== -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia
        ixx="${2.0 * (3*base_radius**2 + base_height**2) / 12}" ixy="0.0" ixz="0.0"
        iyy="${2.0 * (3*base_radius**2 + base_height**2) / 12}" iyz="0.0"
        izz="${2.0 * base_radius**2 / 2}"/>
    </inertial>
  </link>

  <!-- ========== 6 个关节，轴序列 z-y-y-z-y-z（仿 UR 布局） ========== -->

  <!-- 关节1：腰部回转 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_height/2}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="100" velocity="1.0"/>
  </joint>
  <xacro:arm_link name="link1" radius="0.045" length="${link1_height}" mass="1.0" color="orange"/>

  <!-- 关节2：肩部俯仰 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link1_height}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="100" velocity="1.0"/>
  </joint>
  <xacro:arm_link name="link2" radius="0.04" length="${link2_length}" mass="0.9" color="grey"/>

  <!-- 关节3：肘部俯仰 -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${link2_length}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-2*pi/3}" upper="${2*pi/3}" effort="100" velocity="1.0"/>
  </joint>
  <xacro:arm_link name="link3" radius="0.035" length="${link3_length}" mass="0.6" color="orange"/>

  <!-- 关节4：腕部滚转（绕小臂轴线自转） -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${link3_length}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="50" velocity="2.0"/>
  </joint>
  <xacro:arm_link name="link4" radius="0.03" length="${link4_length}" mass="0.25" color="grey"/>

  <!-- 关节5：腕部俯仰 -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 ${link4_length}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="50" velocity="2.0"/>
  </joint>
  <xacro:arm_link name="link5" radius="0.028" length="${link5_length}" mass="0.2" color="orange"/>

  <!-- 关节6：法兰滚转（工具自转定向） -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 ${link5_length}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="30" velocity="2.0"/>
  </joint>
  <xacro:arm_link name="link6" radius="0.025" length="${link6_length}" mass="0.15" color="grey"/>

  <!-- ========== 末端法兰（固定关节，TCP 工具点） ========== -->
  <joint name="joint_tool" type="fixed">
    <parent link="link6"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${link6_length}"/>
  </joint>
  <link name="tool0"/>

</robot>